{
	"name": "@r2digisolutions/components",
	"version": "0.9.4",
	"private": false,
	"description": "R2DigiSolutions Svelte 5 component library — Atomic Design, Tailwind 4, Light/Dark mode",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/r2digitalsolutions/components.git"
	},
	"publishConfig": {
		"access": "public",
		"provenance": false
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && npm run prepack",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"prepack": "svelte-kit sync && svelte-package && publint",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run && npm run test:e2e",
		"test:e2e": "playwright install && playwright test",
		"storybook": "storybook dev -p 6006",
		"storybook:build": "storybook build -o storybook-static",
		"release": "bumpp",
		"release:patch": "bumpp patch --commit --tag --push",
		"release:minor": "bumpp minor --commit --tag --push",
		"release:major": "bumpp major --commit --tag --push"
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"sideEffects": [
		"**/*.css"
	],
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"type": "module",
	"style": "./dist/styles.css",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js"
		},
		"./styles.css": "./dist/styles.css"
	},
	"peerDependencies": {
		"@lucide/svelte": ">=0.400.0",
		"@sveltejs/kit": ">=2.0.0",
		"svelte": "^5.0.0"
	},
	"peerDependenciesMeta": {
		"@lucide/svelte": {
			"optional": true
		},
		"@sveltejs/kit": {
			"optional": true
		}
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@lucide/svelte": "^1.34.0",
		"@playwright/test": "^1.62.1",
		"@storybook/addon-a11y": "^10.5.10",
		"@storybook/addon-docs": "^10.5.10",
		"@storybook/addon-svelte-csf": "^5.1.2",
		"@storybook/addon-themes": "^10.5.10",
		"@storybook/svelte": "^10.5.10",
		"@storybook/sveltekit": "^10.5.10",
		"@sveltejs/adapter-static": "next",
		"@sveltejs/kit": "next",
		"@sveltejs/package": "^2.5.8",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^26.3.0",
		"@vitest/browser-playwright": "^4.1.11",
		"bumpp": "~12.2.1",
		"eslint": "^10.9.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.11.0",
		"mdsvex": "^0.12.8",
		"playwright": "^1.62.1",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"publint": "^0.3.24",
		"storybook": "^10.5.10",
		"svelte": "^5.56.10",
		"svelte-check": "^4.7.6",
		"tailwindcss": "^4.3.3",
		"typescript": "6.0.3",
		"typescript-eslint": "^8.68.0",
		"vite": "^8.2.2",
		"vitest": "^4.1.11",
		"vitest-browser-svelte": "^3.0.0"
	},
	"keywords": [
		"svelte",
		"svelte5",
		"components",
		"ui",
		"tailwindcss",
		"atomic-design"
	],
	"dependencies": {
		"@xyflow/svelte": "^1.6.5"
	}
}
